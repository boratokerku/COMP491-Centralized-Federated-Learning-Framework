# Copy to deploy/.env and fill in. deploy/.env is gitignored. Use passwords without
# '@', ':' or '/' (they are embedded in database URLs).

# PostgreSQL owner (gateway, coordinator, migrations)
POSTGRES_USER=cfl
POSTGRES_PASSWORD=
POSTGRES_DB=cfl
# Read-only role for the website and Grafana
CFL_WEB_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Hostnames. Local testing: fl.localhost / localhost (Caddy's own CA).
# Cloud VM with public IP 203.0.113.7: fl.203-0-113-7.sslip.io / 203-0-113-7.sslip.io
CFL_GATEWAY_DOMAIN=fl.localhost
CFL_WEB_DOMAIN=localhost
# Change only for local testing when 80/443 are taken; the VM must use 80 and 443.
CFL_HTTP_PORT=80
CFL_HTTPS_PORT=443
# Host port for administration access to PostgreSQL (bound to 127.0.0.1 only)
CFL_POSTGRES_PORT=5432

# Client versions accepted at registration, e.g. cfl-client/0.1.*,independent-client/*
# (empty: any version)
CFL_ALLOWED_CLIENT_VERSIONS=

# Image tag to build or pull (e.g. ghcr.io/boratokerku/cfl-server:0.1.0 via CFL_SERVER_IMAGE)
CFL_VERSION=dev
# Directory with the server's held-out test sets, relative to deploy/
CFL_SERVER_DATA=../data
