# Two hostnames on the VM's public IP (planning/interfaces.md, section 6):
#   CFL_GATEWAY_DOMAIN  client API (gateway), e.g. fl.203-0-113-7.sslip.io
#   CFL_WEB_DOMAIN      website and Grafana, e.g. 203-0-113-7.sslip.io
# Plain HTTP is only redirected to HTTPS; nothing is served over it.

{$CFL_GATEWAY_DOMAIN} {
	request_body {
		max_size 64MB
	}
	reverse_proxy gateway:8000
}

{$CFL_WEB_DOMAIN} {
	# Grafana is only reachable with a website session. forward_auth asks the website
	# (/api/auth/verify) first: without a session the visitor is sent to the login form;
	# with one, the user name is passed on in X-WEBAUTH-USER and Grafana (auth proxy mode)
	# signs that user in as a viewer. Any X-WEBAUTH-USER sent by the visitor is dropped first.
	handle /grafana* {
		# route keeps this order: Caddy would otherwise run request_header after forward_auth
		# and delete the verified header as well.
		route {
			request_header -X-WEBAUTH-USER
			forward_auth web:3000 {
				uri /api/auth/verify?redirect=1
				copy_headers X-Auth-User>X-WEBAUTH-USER
			}
			reverse_proxy grafana:3000
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
