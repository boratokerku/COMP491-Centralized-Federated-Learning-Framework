@startuml Deployment_Diagram
skinparam defaultFontName Arial
skinparam fontSize 11
skinparam roundcorner 8
skinparam shadowing false
skinparam packageStyle rectangle

skinparam nodesep 25
skinparam ranksep 35

skinparam node {
    BorderColor #2C3E50
    BackgroundColor #FFFFFF
    FontColor #2C3E50
    FontStyle bold
}

skinparam package {
    BorderColor #34495E
    BackgroundColor #F8F9FA
    FontColor #2C3E50
    FontStyle bold
}

skinparam component {
    BorderColor #2980B9
    BackgroundColor #EBF5FB
    FontColor #1B4F72
}

skinparam database {
    BorderColor #27AE60
    BackgroundColor #E8F8F5
    FontColor #145A32
}

skinparam storage {
    BorderColor #D35400
    BackgroundColor #FBEEE6
    FontColor #6E2C00
}

skinparam arrow {
    Color #2C3E50
    FontColor #2C3E50
    FontSize 10
}

title Centralized Federated Learning Framework - Multi-Machine Deployment Topology

' ==============================================================================
' 1. DISTRIBUTED CLIENT SITES (TOP)
' ==============================================================================
package "Distributed Client Machines (Simulating Independent Silos)" as ClientsPkg {

    node "Client Machine 1\n(Workstation / Laptop)" as Node1 {
        [cfl-client (Docker/Python)\n- Conformance Checker\n- PyTorch Local Trainer\n- Safetensors Serializer] as Agent1
        database "Local Data Partition 1\n(Tabular / Image / Text)" as Data1
        Agent1 -down-> Data1 : Read
    }

    node "Client Machine 2\n(University Cluster Node)" as Node2 {
        [cfl-client (Docker/Python)\n- Conformance Checker\n- PyTorch Local Trainer\n- Safetensors Serializer] as Agent2
        database "Local Data Partition 2\n(Tabular / Image / Text)" as Data2
        Agent2 -down-> Data2 : Read
    }

    node "Client Machine 3\n(Cloud VM / Remote Host)" as Node3 {
        [cfl-client (Docker/Python)\n- Conformance Checker\n- PyTorch Local Trainer\n- Safetensors Serializer] as Agent3
        database "Local Data Partition 3\n(Tabular / Image / Text)" as Data3
        Agent3 -down-> Data3 : Read
    }

    node "Client Machine 4\n(Fault Injection Simulator)" as Node4 {
        [cfl-client (Test Mode)\n- Straggler / Artificial Delay\n- Mid-Round Disconnection\n- Stale Update Generator] as Agent4
        database "Local Data Partition 4\n(Tabular / Image / Text)" as Data4
        Agent4 -down-> Data4 : Read
    }
}

' ==============================================================================
' 2. PUBLIC NETWORK / WAN (CENTER)
' ==============================================================================
cloud "Public Internet / Campus WAN  [TLS 1.3 / HTTPS (Port 443)]" as WAN

Agent1 -down-> WAN : HTTPS (Port 443)
Agent2 -down-> WAN : HTTPS (Port 443)
Agent3 -down-> WAN : HTTPS (Port 443)
Agent4 -down-> WAN : HTTPS (Port 443)

' ==============================================================================
' 3. CENTRAL COORDINATION SERVER (BOTTOM)
' ==============================================================================
node "Central Server (Server / Cloud VM with Public IP)" as ServerHost {

    package "Edge Reverse Proxy" as IngressPkg {
        [cfl-caddy (Docker Container)\n- Auto TLS 1.3 Termination (Let's Encrypt / CA)\n- Ingress Router (/api/* -> Gateway | /* -> WebApp)\n- Security Headers & SSL Termination] as Caddy
    }

    WAN -down-> Caddy : Port 443 / 80

    package "Docker Compose Stack: cfl-backend" as BackendStack {
        [cfl-gateway (FastAPI Container)\n- REST Endpoints (:8000)\n- Bearer Token Auth & Checksums\n- Idempotency & Stale Filters] as Gateway

        [cfl-coordinator (Engine Container)\n- Round State Machine (OPEN/COLL/AGG/DONE)\n- FedAvg & FedProx Aggregator\n- Crash Recovery & State Resume] as Coordinator

        Gateway <..> Coordinator : Round Events & Triggers
    }

    Caddy -down-> Gateway : Proxy /api/* (:8000)

    package "Docker Compose Stack: cfl-storage" as StorageStack {
        storage "Host Volume: /data/models/\n- global_model_v(t).safetensors\n- client_updates_v(t).safetensors\n- final_model.onnx + sha256" as VolModels

        database "cfl-postgres (PostgreSQL 16)\n- Runs, Rounds, Clients\n- Conformance Reports\n- Updates & Telemetry Logs" as Postgres

        storage "Host Volume: /data/reports/\n- experiment_summary.md\n- metrics_history.csv / .json\n- convergence_plots.png" as VolReports
    }

    Gateway -down-> VolModels : Write Updates
    Gateway -down-> Postgres : Save Metadata
    Coordinator -down-> Postgres : Persist State
    Coordinator -down-> VolModels : Save Global Model
    Coordinator -down-> VolReports : Export Reports & Plots

    package "Docker Compose Stack: cfl-ui" as UIStack {
        [cfl-frontend (Next.js Web Portal)\n- Public Area (Overview, Video, Poster)\n- Private Dashboard (Live Rounds, Logs)] as WebApp

        [cfl-grafana (Grafana Server :3001)\n- Loss / Accuracy / F1 Curves\n- Round Durations & Dropout Rates] as Grafana
    }

    Caddy -down-> WebApp : Proxy /* (:3000)
    Postgres -down-> WebApp : Query Runs & Logs
    Postgres -down-> Grafana : Telemetry Stream
    VolReports -down-> WebApp : Download Reports
    VolModels -down-> WebApp : Download Models
}

@enduml
