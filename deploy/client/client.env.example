# Settings of one participating site. Copy to client.env (gitignored).
CFL_SERVER_URL=https://fl.203-0-113-7.sslip.io
CFL_CLIENT_ID=bank-a
CFL_TASK=tabular
# Absolute path of this site's partition folder (train.csv, val.csv, test.csv)
CFL_PARTITION_DIR=/path/to/partitions/bank_marketing/client_0
# Image to run; pin a version (and digest) for real runs
CFL_CLIENT_IMAGE=ghcr.io/boratokerku/cfl-client:latest
# Only for a server with its own CA (local testing): put root.crt into ./ca and set
# CFL_CA_BUNDLE_IN_CONTAINER=/ca/root.crt
CFL_CA_BUNDLE_IN_CONTAINER=
