@startuml Architecture_Diagram
skinparam defaultFontName Arial
skinparam fontSize 11
skinparam roundcorner 8
skinparam shadowing false
skinparam packageStyle rectangle

skinparam nodesep 55
skinparam ranksep 48
skinparam packagePadding 14
skinparam componentPadding 10

' Color Palette
skinparam package {
    BorderColor #2C3E50
    BackgroundColor #F8F9FA
    FontColor #2C3E50
    FontStyle bold
}

skinparam node {
    BorderColor #34495E
    BackgroundColor #FFFFFF
    FontColor #2C3E50
    FontStyle bold
}

skinparam component {
    BorderColor #2980B9
    BackgroundColor #EBF5FB
    FontColor #1B4F72
}

skinparam database {
    BorderColor #27AE60
    BackgroundColor #E8F8F5
    FontColor #145A32
}

skinparam storage {
    BorderColor #D35400
    BackgroundColor #FBEEE6
    FontColor #6E2C00
}

skinparam arrow {
    Color #34495E
    FontColor #2C3E50
    FontSize 10
}

title Centralized Federated Learning Framework (CFL) - End-to-End System Architecture

' ==============================================================================
' 1. CLIENT SILOS (CROSS-SILO SITES)
' ==============================================================================
package "Participating Organizations (Cross-Silo Client Sites)" as ClientsLayer {

    node "Organization A (Managed-Code Mode)" as NodeA {
        [cfl-client (Docker Container)\n-- Client Subsystems --\n• Conformance Self-Checker (Manifest & Synthetic Test)\n• Local PyTorch Trainer (FedAvg / FedProx)\n• Pluggable Transport (InMemory / HTTPSTransport)\n• Serializer (.safetensors) & SHA-256 Hasher\n• Final Model Verifier (ONNX Test Inference)] as ClientA
        database "Private Local Data A\n[Tabular / Medical Image / Text]\n(Held Strictly Confidential)" as DataA
        ClientA -left-> DataA : Local Read
    }

    node "Organization B (Independent Mode)" as NodeB {
        [Custom Client App (Python / PyTorch)\n-- Conformance Requirements --\n• Complies with Conformance Contract\n• Feature Order, Types & Unit Matching\n• HTTPS REST Client with Bearer Token] as ClientB
        database "Private Local Data B\n(Held Strictly Confidential)" as DataB
        ClientB -left-> DataB : Local Read
    }

    node "Test Client Node C (Fault Injection)" as NodeC {
        [Simulated Test Client\n-- Failure Injection Engine --\n• Straggler (Network Latency / Slow Compute)\n• Mid-Round Dropouts & Reconnects\n• Stale & Duplicate Update Generator] as ClientC
    }
}

' ==============================================================================
' 2. NETWORK & SECURITY INGRESS
' ==============================================================================
cloud "Public Internet / Campus WAN  [TLS 1.3 / HTTPS (Port 443)]" as Internet

ClientA --> Internet : HTTPS Traffic
ClientB --> Internet : HTTPS Traffic
ClientC --> Internet : HTTPS Traffic

' ==============================================================================
' 3. CENTRAL SERVER HOST
' ==============================================================================
node "Central Server (Cloud VM / University Cluster Host)" as CentralServer {

    package "Ingress & Edge Security (Docker: cfl-caddy)" as IngressPkg {
        [Caddy Reverse Proxy & Edge Router\n• Auto TLS 1.3 Certificate (Let's Encrypt / CA)\n• Route /api/* -> FastAPI Gateway (:8000)\n• Route /* -> Next.js Web App (:3000)\n• SSL Termination & Security Headers] as Caddy
    }

    Internet --> Caddy : Port 443 / 80

    package "Core Backend Services (Docker Compose Stack)" as BackendStack {
        [cfl-gateway (FastAPI Container)\n-- REST Ingress Subsystems --\n• Endpoints: /register, /conformance, /task, /model, /update\n• Bearer Token Authentication & Whitelist\n• Idempotency & Stale Filter (update_id)\n• Payload SHA-256 Checksum Validation] as Gateway

        [cfl-coordinator (Federation Engine)\n-- Orchestration Subsystems --\n• Round State Machine (INIT/OPEN/COLL/AGG/DONE/FAILED)\n• Quorum & Timeout Manager (Deadlines & Stragglers)\n• Strategy Engine (FedAvg, FedProx, Centralized & Local Baselines)\n• State Persistence & Crash Recovery (Auto-Resume)\n• Model Artifact Packager & ONNX Exporter\n• Automated End-of-Run Report Generator] as Coordinator

        Gateway <..> Coordinator : Round Events & Triggers
    }

    Caddy --> Gateway : Reverse Proxy /api/*

    package "Storage & Persistence Layer (Docker Volumes)" as StorageStack {
        database "cfl-postgres (PostgreSQL 16)\n-- Relational Database Tables --\n• runs (status, config, manifest_ver)\n• rounds (round_id, status, deadline, duration)\n• clients & conformance_reports\n• updates (update_id, num_samples, metrics)\n• events (dropout, timeout, resume)" as Postgres

        storage "Host Volume: /data/models/\n-- Model Weight Storage --\n• global_model_v(t).safetensors\n• client_updates_v(t).safetensors\n• final_model.onnx + .sha256" as ModelStorage

        storage "Host Volume: /data/reports/\n-- Run Summary Artifacts --\n• experiment_summary.md\n• metrics_history.json / .csv\n• convergence_plots.png (Loss/F1/RTT)" as ReportStorage
    }

    Gateway --> Postgres : Save Registrations & Updates
    Gateway --> ModelStorage : Store Client Weights
    Coordinator --> Postgres : Persist State Transitions & Events
    Coordinator --> ModelStorage : Read Updates & Save Global Model
    Coordinator --> ReportStorage : Export Markdown, CSV & Plots

    package "Observability & Presentation Layer" as UIStack {
        [cfl-frontend (Next.js Web Portal)\n-- Web Modules --\n• Public Zone: Project Scope, Methodology, Team, Video, Poster\n• Private Dashboard: Live Round Monitor, Inbox, Logs, Reports] as WebApp

        [cfl-grafana (Grafana Server :3001)\n-- Telemetry Dashboards --\n• Round Duration & Compute vs Wait Panes\n• Per-Client Loss / Accuracy / F1 Curves\n• Transfer Bytes, Latency & Dropout Rates] as Grafana
    }

    Caddy --> WebApp : Reverse Proxy /*
    Postgres --> WebApp : Query Runs, Rounds & Logs
    Postgres --> Grafana : Telemetry Stream
    ModelStorage --> WebApp : Serve Model Checksums
    ReportStorage --> WebApp : Download Reports & Plots
}

@enduml
